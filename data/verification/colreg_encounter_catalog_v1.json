      "expected_encounter": "crossing_starboard",
      "expected_role": "give_way",
      "actions": [
        {"id": "starboard-substantial", "course_change_deg": 20, "speed_ratio": 0.9, "expected_passed": true},
        {"id": "maintain-unsafe", "course_change_deg": 0, "speed_ratio": 1.0, "expected_passed": false}
      ]
    },
    {
      "id": "COLREG-15-CROSSING-PORT",

      {"dimension_id": "ODD-WIND", "category": "wind", "limit_statement": "Maximum sustained wind is 15 m/s for this research ODD.", "monitor_signal": "wind_speed_mps", "comparator": "lte", "threshold": 15.0, "exit_criteria": "Sustained wind exceeds the declared bound.", "breach_mrc_ids": ["MRC-03", "MRC-02"]},
      {"dimension_id": "ODD-WAVE", "category": "wave", "limit_statement": "Maximum significant wave height is 2.5 m for this research ODD.", "monitor_signal": "significant_wave_height_m", "comparator": "lte", "threshold": 2.5, "exit_criteria": "Wave height exceeds the declared bound.", "breach_mrc_ids": ["MRC-03", "MRC-02"]},
      {"dimension_id": "ODD-VIS", "category": "visibility", "limit_statement": "Minimum visibility is 2 nautical miles.", "monitor_signal": "visibility_nm", "comparator": "gte", "threshold": 2.0, "exit_criteria": "Visibility falls below 2 nautical miles.", "breach_mrc_ids": ["MRC-03", "MRC-01"]},
      {"dimension_id": "ODD-TRAFFIC", "category": "traffic_complexity", "limit_statement": "No more than 20 tracked traffic targets are admitted.", "monitor_signal": "tracked_targets", "comparator": "lte", "threshold": 20, "exit_criteria": "Tracked traffic exceeds the assessed capacity.", "breach_mrc_ids": ["MRC-03", "MRC-01"]},
      {"dimension_id": "ODD-GNSS", "category": "positioning_integrity", "limit_statement": "GNSS integrity checks must remain healthy.", "monitor_signal": "gnss_integrity_ok", "comparator": "eq", "threshold": true, "exit_criteria": "Integrity, freshness or anti-spoofing checks fail.", "breach_mrc_ids": ["MRC-03", "MRC-01"]},
      {"dimension_id": "ODD-FUSION", "category": "navigation_fusion_quality", "limit_statement": "Fused navigation integrity score must be at least 0.8.", "monitor_signal": "fusion_integrity", "comparator": "gte", "threshold": 0.8, "exit_criteria": "Multi-source integrity falls below 0.8.", "breach_mrc_ids": ["MRC-03", "MRC-01"]},
      {"dimension_id": "ODD-CONTROL", "category": "actuator_feedback", "limit_statement": "Steering and propulsion feedback must agree with bounded commands.", "monitor_signal": "control_feedback_ok", "comparator": "eq", "threshold": true, "exit_criteria": "Command/feedback confirmation times out or disagrees.", "breach_mrc_ids": ["MRC-01", "MRC-05"]},
      {"dimension_id": "ODD-RCC", "category": "remote_control_centre_link", "limit_statement": "The supervised remote-control-centre link must be available when that mode is selected.", "monitor_signal": "rcc_link_available", "comparator": "eq", "threshold": true, "exit_criteria": "Both primary and backup RCC communication paths are unavailable.", "breach_mrc_ids": ["MRC-01", "MRC-02"]},
      {"dimension_id": "ODD-CYBER", "category": "cyber_integrity", "limit_statement": "Identity, message integrity and audit-chain checks must remain healthy.", "monitor_signal": "cyber_integrity_ok", "comparator": "eq", "threshold": true, "exit_criteria": "Authentication, integrity or audit validation fails.", "breach_mrc_ids": ["MRC-05"]},
      {"dimension_id": "ODD-SPEED", "category": "speed_envelope", "limit_statement": "Maximum permitted speed in the research ODD is 12 knots.", "monitor_signal": "speed_knots", "comparator": "lte", "threshold": 12.0, "exit_criteria": "Speed exceeds the declared ODD envelope.", "breach_mrc_ids": ["MRC-03"]}
    ]
  },

    {"hazard_id": "HZ-06", "category": "power_failure", "description": "Loss of controller, I/O rack, sensor or bridge power.", "causes": ["supply loss", "UPS failure", "distribution fault"], "consequences": ["loss of control", "loss of awareness"], "initial_risk": "INTOLERABLE", "controls": [{"control_id": "CTL-POWER", "type": "preventive", "description": "Independent power and UPS evidence contract.", "evidence_ids": ["EV-HIL"]}, {"control_id": "CTL-POWER-NEUTRAL", "type": "mitigative", "description": "Power-loss neutralisation and manual re-arm.", "evidence_ids": ["EV-HIL"]}], "residual_risk": "ALARP_HIGH", "mrc_ids": ["MRC-01", "MRC-05"], "risk_owner_role": "TECHNICAL_AUTHORITY", "acceptance_status": "REQUIRES_EXTERNAL_ACCEPTANCE"},
    {"hazard_id": "HZ-07", "category": "communication_loss", "description": "Loss or excessive delay of remote-control-centre communications.", "causes": ["primary link loss", "backup link loss", "network congestion"], "consequences": ["loss of supervision", "stale command"], "initial_risk": "INTOLERABLE", "controls": [{"control_id": "CTL-RCC-LINK", "type": "detective", "description": "Dual-path link health and command-age monitoring.", "evidence_ids": ["EV-HIL"]}, {"control_id": "CTL-RCC-LOSS", "type": "mitigative", "description": "No automatic re-arm after disconnect; onboard/manual path takes priority.", "evidence_ids": ["EV-HIL", "EV-CONTROL"]}], "residual_risk": "ALARP_HIGH", "mrc_ids": ["MRC-01", "MRC-02"], "risk_owner_role": "RCC_SUPERVISOR", "acceptance_status": "REQUIRES_EXTERNAL_ACCEPTANCE"},

        {"id": "maintain-course-speed", "course_change_deg": 0, "speed_ratio": 1.0, "expected_passed": true},
        {"id": "unnecessary-large-change", "course_change_deg": 20, "speed_ratio": 1.0, "expected_passed": false}
      ]
    },
    {
      "id": "COLREG-13-OVERTAKING",
      "own": {"vessel_id": "own", "east_m": 0, "north_m": 0, "heading_deg": 0, "speed_mps": 6},

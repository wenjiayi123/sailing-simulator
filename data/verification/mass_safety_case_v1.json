{
  "schema_version": "mass_safety_case_v1",
  "safety_case_id": "rl_navigation_simulator_safety_case_v1",
  "title": "RL 航行模拟器研究运行安全案例",
  "scope": {
    "system": "RL-oriented ship-navigation simulator and its bounded safety, sensor, execution-control and evidence layers",
    "lifecycle_stage": "research_simulator_functional_assurance",
    "intended_use": "reinforcement-learning training, evaluation, instructor-led simulation and evidence rehearsal",
    "excluded_uses": [
      "unsupervised live-vessel control",
      "production dispatch",
      "type or class approval claim",
      "substitution for the master, officer of the watch or competent authority"
    ],
    "change_control": "Any model, policy, ODD, hazard, control or evidence change requires a new versioned safety-case assessment."
  },
  "top_claim": {
    "claim_id": "SC-TOP",
    "statement": "Within the declared simulator research scope and ODD, hazards are identified and routed to bounded controls and minimum-risk responses with traceable evidence.",
    "status": "SUPPORTED_FOR_SIMULATOR_RESEARCH_ONLY"
  },
  "operational_design_domain": {
    "odd_id": "SIM-ODD-V1",
    "status": "SIMULATOR_BOUNDED_NOT_SITE_APPROVED",
    "dimensions": [

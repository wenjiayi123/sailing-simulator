{
  "schema_version": "colreg_encounter_catalog_v1",
  "safe_dcpa_m": 500.0,
  "tcpa_horizon_s": 900.0,
  "boundary": "Powered-vessel deterministic regression cases; not a complete legal or certification test suite.",
  "scenarios": [
    {
      "id": "COLREG-14-HEAD-ON",
      "own": {"vessel_id": "own", "east_m": 0, "north_m": 0, "heading_deg": 0, "speed_mps": 5},
      "target": {"vessel_id": "target", "east_m": 0, "north_m": 1000, "heading_deg": 180, "speed_mps": 5},
      "expected_encounter": "head_on",
      "expected_role": "both_give_way",
      "actions": [
        {"id": "starboard-substantial", "course_change_deg": 20, "speed_ratio": 1.0, "expected_passed": true},
        {"id": "port-alteration", "course_change_deg": -20, "speed_ratio": 1.0, "expected_passed": false}
      ]
    },
    {
      "id": "COLREG-15-CROSSING-STARBOARD",
      "own": {"vessel_id": "own", "east_m": 0, "north_m": 0, "heading_deg": 0, "speed_mps": 5},
